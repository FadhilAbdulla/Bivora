# Prisma Postgres, shared by production and local. Copy both from the database's settings on Vercel.
# Careful: local changes affect real data.
DATABASE_URL=""
DATABASE_URL_POOLED=""
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ARK trader integration (pending) — see docs/ark-api.md
# Gateway base URL, e.g. https://<broker>.arktrader.io/api/apigateway
ARK_API_URL=""
ARK_COMPANY_NAME=""
ARK_DEALER_USERNAME=""
ARK_DEALER_PASSWORD=""
# Assigned to each new client. Get these from your broker.
ARK_PARENT_ID=""
ARK_GENERIC_POLICY_ID=""
ARK_CURRENCIES_POLICY_ID=""
ARK_CURRENCY_ID=""
# Where clients log in to trade. Used in the email with their login details.
ARK_TRADING_URL=""

# Email through Resend, e.g. EMAIL_FROM="Bivora <support@bivoramarkets.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Google login. The button stays hidden until these are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public site URL, used for absolute links in share previews (Open Graph), e.g. https://bivoramarkets.com
NEXT_PUBLIC_SITE_URL=""

# Private Cloudflare R2 bucket for identity documents. Keep public access off.
# The bucket's CORS policy must allow PUT and GET from the site's address.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
