# Prisma Postgres, shared by production and local. Copy both from the database's settings on Vercel.
# Careful: local changes affect real data.
DATABASE_URL=""
DATABASE_URL_POOLED=""
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Encrypts the ARK dealer password in the database. Must be the same everywhere that uses this database.
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""

# Lets Vercel Cron call /api/cron/ark-heartbeat, which keeps the ARK dealer session open.
# Any random string of 16+ characters, e.g. openssl rand -base64 32
CRON_SECRET=""

# Email through Resend, e.g. EMAIL_FROM="Bivora <support@bivoramarkets.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Google login. The button stays hidden until these are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public site URL, used for absolute links in share previews (Open Graph), e.g. https://bivoramarkets.com
NEXT_PUBLIC_SITE_URL=""

# Private Cloudflare R2 bucket for identity documents. Keep public access off.
# The bucket's CORS policy must allow PUT and GET from the site's address.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
