generator client {
  provider = "prisma-client-js"
}

// Prisma Postgres on Vercel, shared by production and local development.
// The app connects through the pool; migrations need the direct connection.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

// role:   USER | SUPER_ADMIN
// status: ACTIVE | SUSPENDED
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Empty for clients who only sign in with Google.
  passwordHash    String?
  googleId        String?   @unique
  // Bumped when the password changes or the account is suspended, ending every existing session.
  sessionVersion  Int       @default(0)
  passwordResetSentAt DateTime?
  firstName       String
  lastName        String
  phone           String?
  country         String?
  role            String    @default("USER")
  status          String    @default("ACTIVE")
  balance         Decimal   @default(0)
  currency        String    @default("USD")
  // ARK trader account, created when a super admin approves the client.
  // The password is only ever emailed to the client, never stored here.
  arkAccountId    String?
  arkUserId       String?
  arkUsername     String?
  // Set by an admin who chose the client's password: the same password is given to their ARK
  // account at approval, then this is cleared. Encrypted like the ARK dealer password.
  arkPasswordEnc  String?
  // Whether the client's ARK account is a demo account (switched from the client's page).
  arkIsDemo       Boolean   @default(false)
  arkCredentialsSentAt DateTime?
  // Onboarding. kycStatus: NOT_SUBMITTED | PENDING | APPROVING | APPROVED | REJECTED
  termsAcceptedAt DateTime?
  termsVersion    String?
  kycStatus       String    @default("NOT_SUBMITTED")
  kycNote         String?
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fundRequests     FundRequest[] @relation("requester")
  reviewedRequests FundRequest[] @relation("reviewer")
  ledgerEntries    LedgerEntry[]
  kycDocuments     KycDocument[]
  bankAccounts     BankAccount[]
  arkMoney         ArkMoneyTransaction[] @relation("arkMoneyClient")
  arkMoneyMade     ArkMoneyTransaction[] @relation("arkMoneyAdmin")
  arkTransactions  ArkTransaction[]
}

// type:   DEPOSIT | WITHDRAWAL
// status: PENDING | APPROVED | REJECTED | CANCELLED
model FundRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("requester", fields: [userId], references: [id])
  type          String
  amount        Decimal
  currency      String    @default("USD")
  method        String
  // Deposit: payment reference / transaction hash. Withdrawal: payout destination.
  reference     String?
  payoutDetails String?
  userNote      String?
  status        String    @default("PENDING")
  adminNote     String?
  reviewedById  String?
  reviewedBy    User?     @relation("reviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Every balance change is recorded here. amount is signed (+credit / -debit).
model LedgerEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  amount        Decimal
  balanceAfter  Decimal
  description   String
  fundRequestId String?
  fundRequest   FundRequest? @relation(fields: [fundRequestId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}

// Saved payout destinations for withdrawals.
model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountHolder String
  accountNumber String
  iban          String?
  swiftCode     String?
  branch        String?
  country       String?
  currency      String   @default("USD")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Identity documents. Files live outside the public folder (see src/lib/kyc-storage.ts).
// type: PASSPORT | EMIRATES_ID | PROOF_OF_ADDRESS, slot: FRONT | BACK | MAIN
model KycDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  slot       String
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  @@unique([userId, type, slot])
}

// Messages sent through the public contact form, read in the admin console.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// The one set of details for connecting to ARK, managed at /admin/settings.
// The dealer password is encrypted (see src/lib/secrets.ts).
model ArkSettings {
  id                 String   @id @default("ark")
  apiUrl             String
  companyName        String
  dealerUsername     String
  dealerPasswordEnc  String
  parentId           Int
  genericPolicyId    Int
  currenciesPolicyId Int
  // Not a setting any more: ARK's userCurrencyId is always 1. Kept so no migration is needed.
  currencyId         Int
  tradingUrl         String
  // The shared ARK session (see src/lib/ark/client.ts). The token is encrypted.
  sessionTokenEnc    String?
  sessionUsedAt      DateTime?
  sessionLoginAt     DateTime?
  updatedAt          DateTime @updatedAt
}

// Who changed the ARK settings and which fields. Never the values.
model ArkSettingsChange {
  id         String   @id @default(cuid())
  adminEmail String
  fields     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Fixed-window counters for login, signup, reset and contact attempts (src/lib/rate-limit.ts).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}


// Money an admin posts to a client's ARK account from the Money flow page (credit in/out,
// adjustment, bonus). The row id goes to ARK as requestReference, so ARK refuses a repeat.
model ArkMoneyTransaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("arkMoneyClient", fields: [userId], references: [id])
  arkUserId   String
  // ARK trxType: 1 deposit, 2 withdrawal, 3 credit in, 4 credit out, 5 adjustment, 6 bonus.
  type        Int
  amount      Decimal
  comment     String?
  // PENDING while ARK is asked, then DONE or FAILED (with ARK's message in error).
  status      String    @default("PENDING")
  error       String?
  arkTrxId    String?
  adminId     String
  admin       User      @relation("arkMoneyAdmin", fields: [adminId], references: [id])
  emailSentAt DateTime?
  // When it was last sent to ARK; a send still PENDING long after this was cut off.
  attemptAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// A copy of every ARK money transaction on a Bivora client's ARK account, whether it was made in
// Bivora or in ARK directly, so the client's page can show it. Filled from ARK's money report
// (Money flow, the client's page) and straight away when Bivora posts one. id is ARK's transaction ID.
model ArkTransaction {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  arkUserId    String
  // ARK transactionTypeId: 1 deposit, 2 withdrawal, 3 credit in, 4 credit out, 5 adjustment, 6 bonus.
  type         Int
  amount       Decimal
  comment      String?
  reference    String?
  madeInBivora Boolean  @default(false)
  // ARK's own time, as it sends it (server local time, yyyy-MM-dd HH:mm:ss), so it sorts as text.
  time         String
  savedAt      DateTime @default(now())

  @@index([userId, time])
}

// The last good ARK reply for each admin view, so pages show it at once and refresh it in the
// background (src/lib/ark/cache.ts). Safe to empty at any time.
model ArkCache {
  key          String    @id
  data         Json
  fetchedAt    DateTime
  // Set while one server refreshes this entry, so others don't do the same.
  refreshingAt DateTime?
}
