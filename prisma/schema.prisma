generator client {
  provider = "prisma-client-js"
}

// Prisma Postgres on Vercel, shared by production and local development.
// The app connects through the pool; migrations need the direct connection.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

// role:   USER | SUPER_ADMIN
// status: ACTIVE | SUSPENDED
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Empty for clients who only sign in with Google.
  passwordHash    String?
  googleId        String?   @unique
  firstName       String
  lastName        String
  phone           String?
  country         String?
  role            String    @default("USER")
  status          String    @default("ACTIVE")
  balance         Decimal   @default(0)
  currency        String    @default("USD")
  // ARK trader account, created when a super admin approves the client.
  // The password is only ever emailed to the client, never stored here.
  arkAccountId    String?
  arkUserId       String?
  arkUsername     String?
  arkCredentialsSentAt DateTime?
  // Onboarding. kycStatus: NOT_SUBMITTED | PENDING | APPROVING | APPROVED | REJECTED
  termsAcceptedAt DateTime?
  termsVersion    String?
  kycStatus       String    @default("NOT_SUBMITTED")
  kycNote         String?
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fundRequests     FundRequest[] @relation("requester")
  reviewedRequests FundRequest[] @relation("reviewer")
  ledgerEntries    LedgerEntry[]
  kycDocuments     KycDocument[]
  bankAccounts     BankAccount[]
}

// type:   DEPOSIT | WITHDRAWAL
// status: PENDING | APPROVED | REJECTED | CANCELLED
model FundRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("requester", fields: [userId], references: [id])
  type          String
  amount        Decimal
  currency      String    @default("USD")
  method        String
  // Deposit: payment reference / transaction hash. Withdrawal: payout destination.
  reference     String?
  payoutDetails String?
  userNote      String?
  status        String    @default("PENDING")
  adminNote     String?
  reviewedById  String?
  reviewedBy    User?     @relation("reviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Every balance change is recorded here. amount is signed (+credit / -debit).
model LedgerEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  amount        Decimal
  balanceAfter  Decimal
  description   String
  fundRequestId String?
  fundRequest   FundRequest? @relation(fields: [fundRequestId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}

// Saved payout destinations for withdrawals.
model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountHolder String
  accountNumber String
  iban          String?
  swiftCode     String?
  branch        String?
  country       String?
  currency      String   @default("USD")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Identity documents. Files live outside the public folder (see src/lib/kyc-storage.ts).
// type: PASSPORT | EMIRATES_ID | PROOF_OF_ADDRESS, slot: FRONT | BACK | MAIN
model KycDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  slot       String
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  @@unique([userId, type, slot])
}

// Messages sent through the public contact form, read in the admin console.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
