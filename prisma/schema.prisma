generator client {
  provider = "prisma-client-js"
}

// SQLite for local development. For production switch provider to "postgresql"
// and point DATABASE_URL at your Postgres instance.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role:   USER | SUPER_ADMIN
// status: ACTIVE | SUSPENDED
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  country      String?
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  balance      Decimal  @default(0)
  currency     String   @default("USD")
  // ARK trader account login, filled in once the ARK integration is live.
  arkAccountId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fundRequests     FundRequest[] @relation("requester")
  reviewedRequests FundRequest[] @relation("reviewer")
  ledgerEntries    LedgerEntry[]
  bankAccounts     BankAccount[]
}

// type:   DEPOSIT | WITHDRAWAL
// status: PENDING | APPROVED | REJECTED | CANCELLED
model FundRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("requester", fields: [userId], references: [id])
  type          String
  amount        Decimal
  currency      String    @default("USD")
  method        String
  // Deposit: payment reference / transaction hash. Withdrawal: payout destination.
  reference     String?
  payoutDetails String?
  userNote      String?
  status        String    @default("PENDING")
  adminNote     String?
  reviewedById  String?
  reviewedBy    User?     @relation("reviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Every balance change is recorded here. amount is signed (+credit / -debit).
model LedgerEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  amount        Decimal
  balanceAfter  Decimal
  description   String
  fundRequestId String?
  fundRequest   FundRequest? @relation(fields: [fundRequestId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}

// Saved payout destinations for withdrawals.
model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountHolder String
  accountNumber String
  iban          String?
  swiftCode     String?
  branch        String?
  country       String?
  currency      String   @default("USD")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}
